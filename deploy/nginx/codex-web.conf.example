# Replace codex.example.com and install a valid TLS certificate before use.
# The application container remains bound to 127.0.0.1:37821.
server {
    listen 80;
    server_name codex.example.com;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name codex.example.com;

    ssl_certificate /etc/letsencrypt/live/codex.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/codex.example.com/privkey.pem;

    client_max_body_size 100m;

    location = /codex-web {
        return 308 /codex-web/;
    }

    location /codex-web/ {
        proxy_pass http://127.0.0.1:37821;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 1800s;
    }

    location /codex-worker/ {
        proxy_pass http://127.0.0.1:37821;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
